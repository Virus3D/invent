{% extends '@EasyAdmin/crud/detail.html.twig' %}

{% trans_default_domain 'location' %}

{% set location = entity.instance %}

{% block main %}
<div class="container-fluid py-4"
     data-controller="inventory-filter"
     data-inventory-filter-url-value="{{ ea_url().setController('App\\Controller\\LocationCrudController').setAction('detail').setEntityId(location.id) }}"
     data-inventory-filter-location-id-value="{{ location.id }}">

    <div class="row">
        <!-- Основная информация -->
        <div class="col-md-8">
            {{ parent() }}

            <div class="card shadow mb-2">
                <div class="card-header bg-light">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">
                            <i class="bi bi-box-seam"></i> {{ 'show.objects_in_location'|trans(domain: 'location') }}
                        </h5>
                    </div>
                </div>
                <div class="p-1">
                    <twig:InventoryTable
                        :location="location"
                        :booleanToggleCsrfToken="booleanToggleCsrfToken"
                        id="inventory-{{ location.id }}"
                    />
                </div>
            </div>

            <div class="card shadow mb-2">
                <div class="card-header bg-light">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">
                            <i class="bi bi-box-seam"></i> {{ 'show.furniture_in_location'|trans(domain: 'furniture') }}
                        </h5>
                    </div>
                </div>
                <div class="p-1">
                    <twig:FurnitureTable
                        :location="location"
                        :booleanToggleCsrfToken="booleanToggleCsrfToken"
                        id="furniture-{{ location.id }}"
                    />
                </div>
            </div>
        </div>

        <!-- Боковая панель -->
        <div class="col-md-4">
            <!-- Статистика -->
            <div class="card shadow mb-4">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-graph-up"></i> {{ 'show.category_stats'|trans }}
                    </h5>
                </div>
                <div class="card-body">
                    {% set stats = {} %}
                    {% for item in location.inventoryItems %}
                        {% set category = item.category.value %}
                        {% set stats = stats|merge({(category): stats[category]|default(0) + 1}) %}
                    {% endfor %}

                    <div class="row text-center">
                        {% for category_key, count in stats %}
                            {% if count > 0 %}
                                {% set category_enum = get_category_enum(category_key) %}
                                {% if category_enum %}
                                    <div class="col-6 mb-3">
                                        <div class="bg-{{ category_enum.color }} bg-opacity-10 rounded-circle p-3 mx-auto mb-2"
                                            style="width: 70px; height: 70px;">
                                            <i class="bi {{ category_enum.icon }} fs-4 text-{{ category_enum.color }}"></i>
                                        </div>
                                        <h5>{{ count }}</h5>
                                        <small class="text-muted">{{ category_enum|trans }}</small>
                                    </div>
                                {% endif %}
                            {% endif %}
                        {% else %}
                            <div class="col-12 text-center">
                                <p class="text-muted mb-0">{{ 'show.no_data'|trans }}</p>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>

            <!-- Быстрые действия -->
            <div class="card shadow mb-4">
                <div class="card-header bg-light">
                    <h5 class="mb-0">
                        <i class="bi bi-lightning-charge"></i> {{ 'show.quick_actions'|trans }}
                    </h5>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a href="{{ ea_url().setController('App\\Controller\\InventoryItemCrudController').setAction('new').set('location', location.id) }}"
                           class="btn btn-outline-success">
                            <i class="bi bi-plus-circle"></i> {{ 'show.add_new_object'|trans }}
                        </a>
                        <a href="{{ ea_url().setController('App\\Controller\\InventoryItemCrudController').setAction('move').setEntityId(location.id) }}"
                           class="btn btn-outline-warning">
                            <i class="bi bi-arrow-left-right"></i> {{ 'show.move_objects_from_here'|trans }}
                        </a>
                    </div>
                </div>
            </div>

            <!-- Последние перемещения -->
            <div class="card shadow">
                <div class="card-header bg-light">
                    <h5 class="mb-0">
                        <i class="bi bi-clock-history"></i> {{ 'show.recent_movements'|trans }}
                    </h5>
                </div>
                <div class="card-body p-0">
                    {% set recent_logs = [] %}
                    {% for item in location.inventoryItems %}
                        {% for log in item.movementLogs|slice(0, 3) %}
                            {% set recent_logs = recent_logs|merge([log]) %}
                        {% endfor %}
                    {% endfor %}

                    {% if recent_logs|length > 0 %}
                        {% set recent_logs = recent_logs|sort((a, b) => b.movedAt <=> a.movedAt)|slice(0, 5) %}
                        <div class="list-group list-group-flush">
                            {% for log in recent_logs %}
                                <div class="list-group-item">
                                    <div class="d-flex w-100 justify-content-between">
                                        <small class="text-muted">{{ log.movedAt|date('d.m.Y H:i') }}</small>
                                    </div>
                                    <div class="mb-1">
                                        <a href="{{ ea_url().setController('App\\Controller\\InventoryItemCrudController').setAction('detail').setEntityId(log.inventoryItem.id) }}"
                                           class="text-decoration-none">
                                            {{ log.inventoryItem.name }}
                                        </a>
                                    </div>
                                    {% if log.reason %}
                                        <small class="text-muted">{{ log.reason|slice(0, 50) }}{% if log.reason|length > 50 %}...{% endif %}</small>
                                    {% endif %}
                                    <small class="d-block text-muted">
                                        <i class="bi bi-person"></i> {{ log.movedBy }}
                                    </small>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="text-center py-4">
                            <i class="bi bi-clock-history text-muted"></i>
                            <p class="text-muted mt-2 mb-0">{{ 'show.no_movement_history'|trans }}</p>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}