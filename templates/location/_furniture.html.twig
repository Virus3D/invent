{% trans_default_domain 'furniture' %}

{% set default_columns = ['inventory_number', 'name', 'category', 'status', 'created_at', 'actions'] %}
{% set columns = columns|default(default_columns) %}

<div class="card shadow">
    <div class="card-header bg-light">
        <div class="d-flex justify-content-between align-items-center">
            <h5 class="mb-0">
                <i class="bi bi-table"></i> {{ 'show.furniture_in_location'|trans(domain: 'location') }}
            </h5>
            <span class="badge badge-secondary" id="furniture-count">
                {{ furniture|length }}
            </span>
        </div>
    </div>

    {% if furniture|length > 0 %}
    {% include 'furniture/_list.html.twig' %}
    {% else %}
    <div class="card-body text-center py-5">
        <i class="bi bi-armchair display-1 text-muted"></i>
        <h4 class="mt-3 text-muted">{{ 'show.no_furniture'|trans }}</h4>
        <p class="text-muted mb-4">{{ 'show.no_furniture_desc'|trans }}</p>
        <a href="{{ ea_url().setController('App\\Controller\\FurnitureCrudController').setAction('new').set('location', location.id) }}"
           class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> {{ 'show.add_first_furniture'|trans }}
        </a>
    </div>
    {% endif %}
</div>
