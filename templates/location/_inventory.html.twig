<div class="card shadow mb-2">
    <div class="card-header bg-light">
        <div class="d-flex justify-content-between align-items-center">
            <h5 class="mb-0">
                <i class="bi bi-box-seam"></i> {{ 'show.objects_in_location'|trans(domain: 'location') }}
            </h5>
            <span class="badge badge-primary"
                    data-inventory-filter-target="count"
                    id="filtered-objects-count">
                {{ inventoryItems|length }}
            </span>
        </div>
    </div>

    {% if inventoryItems|length > 0 %}
    <div class="position-relative">
        <!-- Индикатор загрузки -->
        <div class="position-absolute top-0 start-0 w-100 h-100 bg-white bg-opacity-75 d-none justify-content-center align-items-center z-3"
                data-inventory-filter-target="loading"
                style="display: none;">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">{{ 'common.messages.loading'|trans(domain: 'messages') }}</span>
            </div>
        </div>

        {# Форма фильтрации #}
        <form method="get"
                class="m-4 filter-form"
                data-inventory-filter-target="form"
                data-action="submit->inventory-filter#filter">
            <div class="row g-3 align-items-end">
                <div class="col-md-3">
                    {{ form_row(filterForm.name, {attr: {
                        'class': 'form-control',
                        'data-action': 'input->inventory-filter#filter'
                    }}) }}
                </div>
                <div class="col-md-3">
                    {{ form_row(filterForm.category, {attr: {
                        'class': 'form-select category-selector',
                        'data-action': 'change->inventory-filter#filter'
                    }}) }}
                </div>
                <div class="col-md-3">
                    {{ form_row(filterForm.status, {attr: {
                        'class': 'form-select',
                        'data-action': 'change->inventory-filter#filter'
                    }}) }}
                </div>
                <div class="col-md-3 d-flex">
                    <div>
                        <button type="submit"
                                class="btn btn-primary filter-btn me-2"
                                data-action="click->inventory-filter#filter"
                                title="{{ 'common.actions.filter'|trans(domain: 'messages') }}">
                            <i class="bi bi-funnel"></i>
                        </button>
                    </div>
                    <div>
                        <button type="button"
                                class="btn btn-outline-secondary reset-btn"
                                data-action="click->inventory-filter#reset"
                                title="{{ 'common.actions.reset'|trans(domain: 'messages') }}">
                            <i class="bi bi-x-circle"></i>
                        </button>
                    </div>
                </div>
            </div>
        </form>

        <!-- Контейнер для контента -->
        <div data-inventory-filter-target="container"
                id="inventory-items-container">
            {{ include('inventory/_list.html.twig', {
                items: inventoryItems,
                columns: ['inventory_number', 'status', 'serial_number', 'checked', 'created_at', 'actions']
            }) }}
        </div>
    </div>

    <div class="card-footer">
        <div class="d-flex justify-content-between align-items-center">
            <small class="text-muted" id="shown-objects-text">
                {{ 'show.shown_objects'|trans({'%count%': inventoryItems|length}) }}
            </small>
        </div>
    </div>
    {% else %}
    <div class="card-body text-center py-5">
        <h4 class="mt-3 text-muted">{{ 'show.no_objects'|trans }}</h4>
        <p class="text-muted mb-4">{{ 'show.no_objects_desc'|trans }}</p>
        <a href="{{ ea_url().setController('App\\Controller\\InventoryItemCrudController').setAction('new').set('location', location.id) }}"
            class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> {{ 'show.add_first_object'|trans }}
        </a>
    </div>
    {% endif %}
</div>
