{% extends '@EasyAdmin/page/content.html.twig' %}


{% form_theme form 'form/fields.html.twig' %}
{% trans_default_domain 'material' %}

{% block content_title %}
    {{ 'write_off.location.heading'|trans({'%name%': material.name}) }}
{% endblock %}

{% block main %}
    <p>{{ 'write_off.available_quantity'|trans }}: <strong>{{ material.quantity }}</strong></p>

    {{ form_start(form) }}
        {{ form_row(form.quantity) }}
        {{ form_row(form.location) }}
        {{ form_row(form.comment) }}
        <button type="submit" class="btn btn-primary">{{ 'common.actions.submit'|trans(domain: 'messages') }}</button>
        <a href="{{ ea_url().setController('App\\Controller\\MaterialCrudController').setAction('index') }}" class="btn btn-secondary">
            {{ 'common.actions.cancel'|trans(domain: 'messages') }}
        </a>
    {{ form_end(form) }}
{% endblock %}