{% extends 'base.html.twig' %}

{% form_theme form 'form/fields.html.twig' %}
{% trans_default_domain 'material' %}
{% set title = 'page.write_off.location'|trans({'%name%': material.name}) %}

{% block body %}
    <h1>{{ 'write_off.location.heading'|trans({'%name%': material.name}) }}</h1>

    <p>{{ 'write_off.available_quantity'|trans }}: <strong>{{ material.quantity }}</strong></p>

    {{ form_start(form) }}
        {{ form_row(form.quantity, {
            label: 'write_off.form.quantity'|trans,
            attr: {min: 0.01, max: material.quantity, step: 0.01}
        }) }}
        {{ form_row(form.location, {
            label: 'write_off.form.location'|trans
        }) }}
        {{ form_row(form.comment, {
            label: 'write_off.form.comment'|trans
        }) }}
        <button type="submit" class="btn btn-primary">{{ 'common.actions.submit'|trans(domain: 'messages') }}</button>
        <a href="{{ path('app_material_index') }}" class="btn btn-secondary">
            {{ 'common.actions.cancel'|trans(domain: 'messages') }}
        </a>
    {{ form_end(form) }}
{% endblock %}