{% extends '@EasyAdmin/page/content.html.twig' %}

{% trans_default_domain 'furniture' %}

{% block page_title %}{{ 'furniture.page.import'|trans }}{% endblock %}

{% block main %}
    <div class="mb-4">
        <div class="alert alert-info">
            <h6 class="alert-heading">{{ 'import.instructions_title'|trans }}</h6>
            <ul class="mb-0">
                <li>{{ 'import.instruction_1'|trans }}</li>
                <li>{{ 'import.instruction_2'|trans }}</li>
                <li>{{ 'import.instruction_3'|trans }}</li>
                <li>{{ 'import.instruction_4'|trans }}</li>
            </ul>
        </div>
    </div>

    {% if createdCount > 0 or skippedCount > 0 or errors|length > 0 %}
        <div class="row mb-4">
            {% if createdCount > 0 %}
                <div class="col-md-4">
                    <div class="card border-success">
                        <div class="card-body text-center">
                            <h5 class="card-title text-success">{{ 'import.created'|trans }}</h5>
                            <h2 class="display-4 text-success">{{ createdCount }}</h2>
                        </div>
                    </div>
                </div>
            {% endif %}

            {% if skippedCount > 0 %}
                <div class="col-md-4">
                    <div class="card border-warning">
                        <div class="card-body text-center">
                            <h5 class="card-title text-warning">{{ 'import.skipped'|trans }}</h5>
                            <h2 class="display-4 text-warning">{{ skippedCount }}</h2>
                        </div>
                    </div>
                </div>
            {% endif %}

            {% if errors|length > 0 %}
                <div class="col-md-4">
                    <div class="card border-danger">
                        <div class="card-body text-center">
                            <h5 class="card-title text-danger">{{ 'import.errors'|trans }}</h5>
                            <h2 class="display-4 text-danger">{{ errors|length }}</h2>
                        </div>
                    </div>
                </div>
            {% endif %}
        </div>

        {% if errors|length > 0 %}
            <div class="alert alert-danger">
                <h6 class="alert-heading">{{ 'import.error_details'|trans }}</h6>
                <ul class="mb-0">
                    {% for error in errors %}
                        <li>{{ error }}</li>
                    {% endfor %}
                </ul>
            </div>
        {% endif %}
    {% endif %}

    {{ form_start(form) }}
    {{ form_errors(form) }}

    <div class="row">
        <div class="col-md-6 mb-3">
            {{ form_row(form.file) }}
        </div>
        <div class="col-md-6 mb-3">
            {{ form_row(form.location) }}
        </div>
    </div>

    <div class="mt-4 d-flex gap-2">
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-file-earmark-arrow-up"></i> {{ 'import.button_import'|trans }}
        </button>
        <a href="{{ ea_url().setController('App\\Controller\\FurnitureCrudController').setAction('downloadTemplate') }}" class="btn btn-outline-secondary">
            <i class="bi bi-download"></i> {{ 'actions.download_template'|trans(domain: 'admin') }}
        </a>
        <a href="{{ ea_url().setController('App\\Controller\\FurnitureCrudController').setAction('index') }}" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> {{ 'actions.back_to_list'|trans(domain: 'admin') }}
        </a>
    </div>

    {{ form_end(form) }}

{% endblock %}
