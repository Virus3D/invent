{% trans_default_domain 'furniture' %}

{% set default_columns = ['inventory_number', 'name', 'category', 'status', 'created_at', 'checked', 'actions'] %}
{% set columns = columns|default(default_columns) %}

<div class="table-responsive">
    <table class="table table-hover">
        <thead class="table-light">
            <tr>
                {% if 'inventory_number' in columns %}
                    <th>{{ 'form.inventory_number'|trans }}</th>
                {% endif %}

                <th>{{ 'form.name'|trans }}</th>

                {% if 'category' in columns %}
                    <th>{{ 'form.category'|trans }}</th>
                {% endif %}

                {% if 'purchase_price' in columns %}
                    <th>{{ 'form.purchase_price'|trans }}</th>
                {% endif %}

                {% if 'responsible_person' in columns %}
                    <th>{{ 'form.responsible_person'|trans }}</th>
                {% endif %}

                {% if 'created_at' in columns %}
                    <th>{{ 'common.messages.added'|trans(domain: 'messages') }}</th>
                {% endif %}

                {% if 'checked' in columns %}
                    <th class="text-center">{{ 'inventory_item.check.label'|trans }}</th>
                {% endif %}

                {% if 'actions' in columns %}
                    <th>{{ 'common.actions.actions'|trans(domain: 'messages') }}</th>
                {% endif %}
            </tr>
        </thead>
        <tbody>
            {% for item in furniture %}
                <tr>
                    {% if 'inventory_number' in columns %}
                        <td>
                            {% include 'fields/balance.html.twig' %}
                        </td>
                    {% endif %}

                    <td>
                        <div class="fw-medium">{{ item.name }}</div>
                        {% if item.description %}
                            <small class="text-muted d-block">{{ item.description|slice(0, 80) }}{% if item.description|length > 80 %}...{% endif %}</small>
                        {% endif %}
                        {% if 'status' in columns %}
                        <div><span class="badge badge-{{ item.status.color }}">
                            <i class="bi {{ item.status.icon }}"></i> {{ item.status|trans }}
                        </span></div>
                        {% endif %}
                    </td>

                    {% if 'category' in columns %}
                        <td>
                            <span class="badge badge-{{ item.category.color }}">
                                <i class="bi {{ item.category.icon }}"></i> {{ item.category|trans(domain: 'furniture') }}
                            </span>
                        </td>
                    {% endif %}

                    {% if 'purchase_price' in columns %}
                        <td>
                            {% if item.purchasePrice %}
                                {{ item.purchasePrice|format_currency('RUB', locale='ru') }}
                            {% else %}
                                <span class="text-muted">—</span>
                            {% endif %}
                        </td>
                    {% endif %}

                    {% if 'responsible_person' in columns %}
                        <td>
                            {% if item.responsiblePerson %}
                                <i class="bi bi-person text-muted"></i> {{ item.responsiblePerson }}
                            {% else %}
                                <span class="text-muted">—</span>
                            {% endif %}
                        </td>
                    {% endif %}

                    {% if 'created_at' in columns %}
                        <td>
                            {% if item.purchaseDate %}
                                <small title="{{ item.purchaseDate|date('d.m.Y H:i:s') }}">
                                    {{ item.purchaseDate|date('d.m.Y') }}
                                </small>
                            {% else %}
                                <small title="{{ item.createdAt|date('d.m.Y H:i:s') }}">
                                    {{ item.createdAt|date('d.m.Y') }}
                                </small>
                            {% endif %}
                        </td>
                    {% endif %}

                    {% if 'checked' in columns %}
                        <td class="text-center">
                            <div class="form-check form-switch"
                                 data-controller="boolean-toggle">
                                <input type="checkbox" class="form-check-input"
                                    {{ item.checked ? 'checked' }}
                                    data-toggle-url="{{ ea_url().setController('App\\Controller\\FurnitureCrudController').setAction('edit').setEntityId(item.id) }}?csrfToken={{ booleanToggleCsrfToken }}&fieldName=checked"
                                    data-boolean-toggle-target="input"
                                    data-action="change->boolean-toggle#toggle"
                                >
                                <label class="form-check-label"></label>
                            </div>
                        </td>
                    {% endif %}

                    {% if 'actions' in columns %}
                        <td>
                            <div class="btn-group">
                                <a href="{{ ea_url().setController('App\\Controller\\FurnitureCrudController').setAction('detail').setEntityId(item.id) }}"
                                    class="btn btn-outline-info" title="{{ 'common.actions.view'|trans(domain: 'messages') }}"
                                    data-bs-toggle="tooltip">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a href="{{ ea_url().setController('App\\Controller\\FurnitureCrudController').setAction('edit').setEntityId(item.id) }}"
                                    class="btn btn-outline-primary" title="{{ 'common.actions.edit'|trans(domain: 'messages') }}"
                                    data-bs-toggle="tooltip">
                                    <i class="bi bi-pencil"></i>
                                </a>
                            </div>
                        </td>
                    {% endif %}
                </tr>
            {% else %}
                <tr>
                    <td colspan="{{ columns|length }}" class="text-center text-muted py-4">
                        <i class="bi bi-inbox display-6"></i>
                        <p class="mt-2">{{ 'show.no_furniture'|trans }}</p>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
