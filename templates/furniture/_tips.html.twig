{% trans_default_domain 'furniture' %}
<div class="mt-3 card">
    <div class="card-header">
        <h6 class="mb-0">
            <i class="bi bi-lightbulb"></i> {{ 'tips.title'|trans }}
        </h6>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                <h6 class="text-success">
                    <i class="bi bi-check-circle"></i> {{ 'tips.do_title'|trans }}
                </h6>
                <ul class="list-unstyled small">
                    <li><i class="bi bi-check text-success"></i> {{ 'tips.do_specific_names'|trans }}</li>
                    <li><i class="bi bi-check text-success"></i> {{ 'tips.do_actual_location'|trans }}</li>
                    <li><i class="bi bi-check text-success"></i> {{ 'tips.do_complete_specifications'|trans }}</li>
                    <li><i class="bi bi-check text-success"></i> {{ 'tips.do_describe_condition'|trans }}</li>
                </ul>
            </div>
            <div class="col-md-6">
                <h6 class="text-danger">
                    <i class="bi bi-x-circle"></i> {{ 'tips.dont_title'|trans }}
                </h6>
                <ul class="list-unstyled small">
                    <li><i class="bi bi-x text-danger"></i> {{ 'tips.dont_generic_names'|trans }}</li>
                    <li><i class="bi bi-x text-danger"></i> {{ 'tips.dont_leaving_required_fields_empty'|trans }}</li>
                    <li><i class="bi bi-x text-danger"></i> {{ 'tips.dont_outdated_information'|trans }}</li>
                </ul>
            </div>
        </div>
    </div>
</div>
