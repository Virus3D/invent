{% extends '@EasyAdmin/crud/detail.html.twig' %}

{% trans_default_domain 'furniture' %}
{% set item = entity.instance %}

{% block main %}
<div class="row mt-4">
    <div class="col-md-8">
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0">
                    <i class="bi bi-info-circle"></i> {{ 'show.main_info'|trans }}
                </h5>
                <span class="{{ item.categoryBadgeClass }}">
                    <i class="bi {{ item.categoryIcon }}"></i> {{ item.category|trans }}
                </span>
            </div>
            <div class="card-body">
                {{ parent() }}

                {% if item.description %}
                    <hr>
                    <h6>{{ 'show.description_label'|trans }}</h6>
                    <p class="card-text">{{ item.description|nl2br }}</p>
                {% endif %}
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h6 class="mb-0">
                    <i class="bi bi-geo-alt"></i> {{ 'show.location'|trans }}
                </h6>
            </div>
            <div class="card-body">
                {% if item.location %}
                    <p class="mb-0">
                        <i class="bi bi-building"></i> {{ item.location.name }}
                        <br>
                        <i class="bi bi-door-open"></i> {{ 'show.room'|trans }}: {{ item.location.roomNumber }}
                    </p>
                {% else %}
                    <p class="text-muted">{{ 'show.no_location'|trans }}</p>
                {% endif %}

                {% if item.responsiblePerson %}
                    <hr>
                    <p class="mb-0">
                        <i class="bi bi-person"></i> {{ 'show.responsible_person'|trans }}: {{ item.responsiblePerson }}
                    </p>
                {% endif %}

                {% if item.purchasePrice %}
                    <hr>
                    <p class="mb-0">
                        <i class="bi bi-cash"></i> {{ 'show.purchase_price'|trans }}: {{ item.purchasePrice }} ₽
                    </p>
                {% endif %}

                {% if item.purchaseDate %}
                    <hr>
                    <p class="mb-0">
                        <i class="bi bi-calendar-event"></i> {{ 'show.purchase_date'|trans }}: {{ item.purchaseDate|date('d.m.Y') }}
                    </p>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
