{# templates/components/inventory_table.html.twig #}

{#
Параметры:
- items: массив объектов инвентаря
- columns: массив колонок для отображения (опционально)
Доступные колонки: inventory_number, name, category, status, serial_number, location, created_at, actions
#}

{% trans_default_domain 'inventory' %}
{% set default_columns = ['inventory_number', 'status', 'serial_number', 'location', 'checked', 'created_at', 'actions'] %}
{% set columns = columns|default(default_columns) %}

<div class="table-responsive">
    <table class="table table-hover">
        <thead class="table-light">
            <tr>
                {% if 'inventory_number' in columns %}
                    <th>{{ 'inventory_item.form.inventory_number_short'|trans }}</th>
                {% endif %}

                <th>{{ 'inventory_item.form.name'|trans }}</th>

                {% if 'serial_number' in columns %}
                    <th>{{ 'inventory_item.form.serial_number'|trans }}</th>
                {% endif %}

                {% if 'location' in columns %}
                    <th>{{ 'inventory_item.form.location'|trans }}</th>
                {% endif %}

                {% if 'created_at' in columns %}
                    <th>{{ 'common.messages.added'|trans(domain: 'messages') }}</th>
                {% endif %}

                {% if 'checked' in columns %}
                    <th class="text-center">{{ 'inventory_item.check.label'|trans }}</th>
                {% endif %}

                {% if 'actions' in columns %}
                    <th>{{ 'common.actions.actions'|trans(domain: 'messages') }}</th>
                {% endif %}
            </tr>
        </thead>
        <tbody>
            {% for item in items %}
                <tr>
                    {% if 'inventory_number' in columns %}
                        <td>
                            {% if item.isOnBalance() %}
                                <strong>{{ item.inventoryNumber }}</strong>
                            {% else %}
                                <span class="badge badge-secondary">
                                    <i class="bi bi-x-circle"></i> {{ 'balance_type.off_balance'|trans }}
                                </span>
                            {% endif %}
                        </td>
                    {% endif %}

                    <td>
                        <div class="d-flex justify-content-between align-items-start">
                            <div class="me-3">
                                <div class="fw-medium">
                                    {% if item.specifications|length > 0 %}
                                    {% set spec_labels = {} %}
                                    {% for key, value in item.specifications %}
                                        {% if value %}
                                            {% set label = ('inventory_item.spec_labels.' ~ key)|default(key|replace({'_': ' '})|title)|trans %}
                                            {% set spec_labels = spec_labels|merge({(key): label}) %}
                                        {% endif %}
                                    {% endfor %}
                                    <span
                                        {{ stimulus_controller('popover', {
                                            specs: item.specifications|json_encode,
                                            labels: spec_labels|json_encode,
                                            title: 'inventory_item.show.specifications'|trans,
                                            placement: 'right',
                                            trigger: 'click hover',
                                            emptyMessage: 'inventory_item.no_specifications'|trans
                                        }) }}
                                        {{ stimulus_target('popover', 'trigger') }}
                                        {{ stimulus_action('popover', 'connect') }}
                                        data-specs-empty="{{ 'inventory_item.no_specifications'|trans }}"
                                        style="cursor: pointer; border-bottom: 1px dashed #6c757d;"
                                        title="{{ 'inventory_item.show.click_for_details'|trans }}">
                                        {{ item.name }}
                                    </span>
                                    {% else %}
                                    {{ item.name }}
                                    {% endif %}
                                    {% if item.purchasePrice %}
                                    <i class="bi bi-cash-coin text-info" title="{{ item.purchasePrice|format_currency('RUB', locale='ru') }}"></i>
                                    {% endif %}
                                </div>
                                {% if item.description %}
                                    <small class="text-muted d-block mt-1">{{ item.description|slice(0, 100) }}{% if item.description|length > 100 %}...{% endif %}</small>
                                {% endif %}
                            </div>
                            <div class="flex-shrink-0">
                                <span class="badge badge-{{ item.category.color }}">
                                    <i class="bi {{ item.category.icon }}"></i> {{ item.category|trans }}
                                </span>
                            </div>
                        </div>
                        {% if 'status' in columns %}
                        <span class="badge badge-{{ item.status.color }}">
                            <i class="bi {{ item.status.icon }}"></i> {{ item.status|trans }}
                        </span>
                        {% endif %}
                    </td>

                    {% if 'serial_number' in columns %}
                        <td>{{ item.serialNumber }}</td>
                    {% endif %}

                    {% if 'location' in columns %}
                        <td>
                            {% if item.location %}
                                <a href="{{ ea_url().setController('App\\Controller\\LocationCurdController').setAction('detail').setEntityId(item.location.id) }}">
                                    {{ item.location }}
                                </a>
                            {% else %}
                                <span class="text-muted">{{ 'inventory_item.not_location'|trans }}</span>
                            {% endif %}
                        </td>
                    {% endif %}

                    {% if 'created_at' in columns %}
                        <td>
                            {% if item.commissioningDate %}
                            <small title="{{ item.commissioningDate|date('d.m.Y H:i:s') }}">
                                {{ item.commissioningDate|date('d.m.Y') }}
                            </small>
                            {% elseif item.purchaseDate %}
                            <small title="{{ item.purchaseDate|date('d.m.Y H:i:s') }}">
                                {{ item.createdAt|date('d.m.Y') }}
                            </small>
                            {% else %}
                            <small title="{{ item.createdAt|date('d.m.Y H:i:s') }}">
                                {{ item.createdAt|date('d.m.Y') }}
                            </small>
                            {% endif %}
                        </td>
                    {% endif %}

                    {% if 'checked' in columns %}
                        <td class="text-center">
                            <div class="form-check form-switch"
                                 data-controller="boolean-toggle">
                                <input type="checkbox" class="form-check-input"
                                    {{ item.checked ? 'checked' }}
                                    data-toggle-url="{{ ea_url().setController('App\\Controller\\InventoryItemCrudController').setAction('edit').setEntityId(item.id) }}?csrfToken={{ booleanToggleCsrfToken }}&fieldName=checked"
                                    data-boolean-toggle-target="input"
                                    data-action="change->boolean-toggle#toggle"
                                >
                                <label class="form-check-label"></label>
                            </div>
                        </td>
                    {% endif %}

                    {% if 'actions' in columns %}
                        <td>
                            <div class="btn-group">
                                <a href="{{ ea_url().setController('App\\Controller\\InventoryItemCrudController').setAction('detail').setEntityId(item.id) }}"
                                   class="btn btn-outline-info" title="{{ 'common.actions.view'|trans(domain: 'messages') }}"
                                   data-bs-toggle="tooltip">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a href="{{ ea_url().setController('App\\Controller\\InventoryItemCrudController').setAction('edit').setEntityId(item.id) }}"
                                   class="btn btn-outline-primary" title="{{ 'common.actions.edit'|trans(domain: 'messages') }}"
                                   data-bs-toggle="tooltip">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a href="{{ ea_url().setController('App\\Controller\\InventoryItemCrudController').setAction('move').setEntityId(item.id) }}"
                                   class="btn btn-outline-warning" title="{{ 'common.actions.move'|trans(domain: 'messages') }}"
                                   data-bs-toggle="tooltip">
                                    <i class="bi bi-arrow-left-right"></i>
                                </a>
                            </div>
                        </td>
                    {% endif %}
                </tr>
            {% else %}
                <tr>
                    <td colspan="{{ columns|length }}" class="text-center text-muted py-4">
                        <i class="bi bi-inbox display-6"></i>
                        <p class="mt-2">{{ 'inventory_item.not'|trans }}</p>
                        <a href="{{ ea_url().setController('App\\Controller\\InventoryItemCrudController').setAction('new') }}" class="btn btn-outline-primary mt-2">
                            <i class="bi bi-plus-circle"></i> {{ 'inventory_item.show.add_first'|trans }}
                        </a>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>
</div>