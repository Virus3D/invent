{% trans_default_domain 'inventory' %}

<div class="card shadow mt-4">
    <div class="card-header bg-light">
        <h5 class="mb-0">
            <i class="bi bi-lightbulb"></i> {{ 'tips.title'|trans }}
        </h5>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                <h6><i class="bi bi-check-circle text-success"></i> {{ 'tips.do_title'|trans }}</h6>
                <ul class="small">
                    <li>{{ 'tips.do_unique_inventory_number'|trans }}</li>
                    <li>{{ 'tips.do_fill_all_pc_specs'|trans }}</li>
                    <li>{{ 'tips.do_serial_number_if_available'|trans }}</li>
                    <li>{{ 'tips.do_describe_condition'|trans }}</li>
                    <li>{{ 'tips.do_specific_names'|trans }}</li>
                    <li>{{ 'tips.do_actual_location'|trans }}</li>
                    <li>{{ 'tips.do_complete_specifications'|trans }}</li>
                </ul>
            </div>
            <div class="col-md-6">
                <h6><i class="bi bi-exclamation-triangle text-warning"></i> {{ 'tips.dont_title'|trans }}</h6>
                <ul class="small">
                    <li>{{ 'tips.dont_duplicate_inventory_numbers'|trans }}</li>
                    <li>{{ 'tips.dont_abbreviations_in_name'|trans }}</li>
                    <li>{{ 'tips.dont_incomplete_description'|trans }}</li>
                    <li>{{ 'tips.dont_inaccurate_location'|trans }}</li>
                    <li>{{ 'tips.dont_generic_names'|trans }}</li>
                    <li>{{ 'tips.dont_leaving_required_fields_empty'|trans }}</li>
                    <li>{{ 'tips.dont_outdated_information'|trans }}</li>
                </ul>
            </div>
        </div>

        <!-- Дополнительная информация -->
        <div class="mt-3 pt-3 border-top">
            <h6 class="mb-2"><i class="bi bi-info-circle text-primary"></i> {{ 'tips.additional_recommendations'|trans }}</h6>
            <div class="row">
                <div class="col-md-4">
                    <div class="card border-primary mb-2">
                        <div class="card-body py-2">
                            <small>
                                <i class="bi bi-calendar-check text-primary"></i>
                                <strong>{{ 'tips.relevance'|trans }}:</strong> {{ 'tips.relevance_desc'|trans }}
                            </small>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-success mb-2">
                        <div class="card-body py-2">
                            <small>
                                <i class="bi bi-shield-check text-success"></i>
                                <strong>{{ 'tips.security'|trans }}:</strong> {{ 'tips.security_desc'|trans }}
                            </small>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card border-info mb-2">
                        <div class="card-body py-2">
                            <small>
                                <i class="bi bi-arrows-move text-info"></i>
                                <strong>{{ 'tips.movements'|trans }}:</strong> {{ 'tips.movements_desc'|trans }}
                            </small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
