{% extends '@EasyAdmin/page/content.html.twig' %}

{% form_theme form 'form/fields.html.twig' %}
{% trans_default_domain 'move' %}

{% block content_title %}
    {{ 'page.move'|trans }}
{% endblock %}

{% block main %}
<div class="card shadow">
    <div class="card-body"
            data-controller="inventory-move"
            data-inventory-move-current-location-id-value="{{ item.location ? item.location.id : '' }}"
            data-inventory-move-show-url-value="{{ ea_url().setController('App\\Controller\\InventoryItemCrudController').setAction('detail').setEntityId(item.id) }}"
            data-inventory-move-submit-url-value="{{ ea_url().setController('App\\Controller\\InventoryItemCrudController').setAction('move').setEntityId(item.id) }}">

        <!-- Контейнер для ошибок (будет создан динамически) -->
        <div data-inventory-move-target="errorContainer"
                class="alert alert-danger d-none"
                role="alert"></div>

        <!-- Информация об объекте -->
        <div class="alert alert-info mb-4">
            <div class="d-flex align-items-center">
                <div class="me-3">
                    <i class="bi bi-box-seam display-6"></i>
                </div>
                <div>
                    <h5 class="mb-1">{{ item.name }}</h5>
                    <p class="mb-0">
                        <strong>{{ 'inventory_item.info.inventory_number_label'|trans(domain: 'inventory') }}</strong> {{ item.inventoryNumber }}<br>
                        <strong>{{ 'inventory_item.info.current_location_label'|trans(domain: 'inventory') }}</strong>
                        {% if item.location %}
                            {{ item.location }}
                        {% else %}
                            <span class="text-muted">{{ 'inventory_item.not_location'|trans(domain: 'inventory') }}</span>
                        {% endif %}
                    </p>
                </div>
            </div>
        </div>

        {{ form_start(form, {
            'attr': {
                'id': 'moveForm',
                'class': 'needs-validation',
                'novalidate': 'novalidate',
                'data-inventory-move-target': 'form',
                'data-action': 'submit->inventory-move#submitForm'
            }
        }) }}

        <!-- Скрытое поле для объекта -->
        {{ form_widget(form.inventoryItem, {'attr': {'style': 'display: none;'}}) }}
        {{ form_row(form.fromLocation, {icon: 'bi bi-geo-alt'}) }}
        {{ form_row(form.toLocation, {icon: 'bi bi-geo-alt-fill'}) }}
        {{ form_row(form.movedBy, {icon: 'bi bi-person'}) }}
        {{ form_row(form.reason, {icon: 'bi bi-card-text'}) }}

        <hr class="my-4">

        <div class="d-flex justify-content-between">
            <a href="{{ ea_url().setController('App\\Controller\\InventoryItemCrudController').setAction('detail').setEntityId(item.id) }}" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> {{ 'common.actions.cancel'|trans(domain: 'messages') }}
            </a>
            <button type="submit"
                    class="btn btn-warning"
                    data-inventory-move-target="submitButton">
                <i class="bi bi-check-circle"></i> {{ 'move.form.submit'|trans }}
            </button>
        </div>

        {{ form_end(form) }}
    </div>
</div>

<!-- История перемещений -->
{% if item.movementLogs|length > 0 %}
<div class="card shadow mt-4">
    <div class="card-header bg-light">
        <h5 class="mb-0">
            <i class="bi bi-clock-history"></i> {{ 'move.history.title'|trans }}
        </h5>
    </div>
    <div class="card-body p-0">
        <div class="list-group list-group-flush">
            {% for log in item.movementLogs|slice(0, 5) %}
                <div class="list-group-item">
                    <div class="d-flex w-100 justify-content-between">
                        <small class="text-muted">
                            {{ log.movedAt|date('d.m.Y H:i') }}
                        </small>
                    </div>
                    <div class="mb-1">
                        {% if log.fromLocation %}
                            <span class="badge bg-light text-dark">
                                {{ log.fromLocation.roomNumber }}
                            </span>
                            <i class="bi bi-arrow-right text-muted mx-1"></i>
                        {% endif %}
                        {% if log.toLocation %}
                            <span class="badge bg-primary">
                                {{ log.toLocation.roomNumber }}
                            </span>
                        {% endif %}
                    </div>
                    {% if log.reason %}
                        <small class="text-muted">{{ log.reason }}</small>
                    {% endif %}
                    <small class="d-block text-muted">
                        <i class="bi bi-person"></i> {{ log.movedBy }}
                    </small>
                </div>
            {% endfor %}
        </div>
        {% if item.movementLogs|length > 5 %}
            <div class="card-footer text-center">
                <a href="{{ ea_url().setController('App\\Controller\\InventoryItemCrudController').setAction('detail').setEntityId(item.id) }}" class="btn btn-sm btn-link">
                    {{ 'move.history.show_all'|trans({'%count%': item.movementLogs|length}) }}
                </a>
            </div>
        {% endif %}
    </div>
</div>
{% endif %}

{% endblock %}
