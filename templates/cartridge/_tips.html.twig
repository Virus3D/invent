{% trans_default_domain 'cartridge' %}

<div class="card shadow mt-4">
    <div class="card-header bg-light">
        <h5 class="mb-0">
            <i class="bi bi-lightbulb"></i> {{ 'tips.title'|trans }}
        </h5>
    </div>
    <div class="card-body">
        <ul class="list-unstyled small mb-0">
            <li class="mb-2">
                <i class="bi bi-check-circle text-success me-1"></i>
                {{ 'tips.name'|trans }}
            </li>
            <li class="mb-2">
                <i class="bi bi-check-circle text-success me-1"></i>
                {{ 'tips.yield'|trans }}
            </li>
            <li class="mb-2">
                <i class="bi bi-check-circle text-success me-1"></i>
                {{ 'tips.printers'|trans }}
            </li>
            <li>
                <i class="bi bi-check-circle text-success me-1"></i>
                {{ 'tips.stock'|trans }}
            </li>
        </ul>
        <div class="alert alert-info mt-3 small">
            <i class="bi bi-info-circle me-1"></i>
            {{ 'tips.compatibility'|trans }}
        </div>
    </div>
</div>
